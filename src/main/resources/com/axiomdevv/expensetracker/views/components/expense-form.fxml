<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="sidebar"
      spacing="9.0"
      maxWidth="1.7976931348623157E308"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.axiomdevv.expensetracker.ui.ExpenseFormController">
    <padding>
        <Insets top="20.0" right="18.0" bottom="20.0" left="18.0"/>
    </padding>

    <Label styleClass="section-kicker" text="NEW TRANSACTION"/>
    <Label styleClass="section-heading" text="Record money in or out" wrapText="true"/>
    <Label styleClass="section-description"
           text="Use Income for money received. Every other category is treated as an expense."
           wrapText="true"/>

    <Label styleClass="field-label" text="Description"/>
    <TextField fx:id="descriptionField"
               promptText="e.g. Weekly groceries"
               accessibleText="Transaction description"/>

    <Label styleClass="field-label" text="Category">
        <VBox.margin><Insets top="4.0"/></VBox.margin>
    </Label>
    <ComboBox fx:id="categoryBox"
              maxWidth="1.7976931348623157E308"
              promptText="Choose a category"
              accessibleText="Transaction category"/>

    <Label styleClass="field-label" text="Date">
        <VBox.margin><Insets top="4.0"/></VBox.margin>
    </Label>
    <DatePicker fx:id="datePicker"
                maxWidth="1.7976931348623157E308"
                promptText="mm/dd/yyyy"
                accessibleText="Transaction date"/>

    <Label styleClass="field-label" text="Amount">
        <VBox.margin><Insets top="4.0"/></VBox.margin>
    </Label>
    <TextField fx:id="amountField"
               promptText="0.00"
               accessibleText="Transaction amount"/>

    <Label fx:id="feedbackLabel"
           styleClass="form-feedback"
           wrapText="true"
           visible="false"
           managed="false"/>

    <HBox spacing="8.0">
        <VBox.margin><Insets top="7.0"/></VBox.margin>
        <Button id="add-button"
                text="Add transaction"
                onAction="#handleAdd"
                maxWidth="1.7976931348623157E308"
                HBox.hgrow="ALWAYS"/>
        <Button id="clear-button"
                text="Clear"
                onAction="#clearForm"/>
    </HBox>
</VBox>
