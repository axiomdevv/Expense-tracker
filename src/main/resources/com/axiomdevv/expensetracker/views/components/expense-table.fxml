<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="content-card"
      spacing="11.0"
      maxWidth="1.7976931348623157E308"
      maxHeight="1.7976931348623157E308"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.axiomdevv.expensetracker.ui.ExpenseTableController">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="2.0">
            <Label styleClass="section-heading" text="Recent transactions"/>
            <Label styleClass="section-description" text="Select one or more rows to delete"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="deleteButton"
                id="delete-button"
                text="Delete selected"
                onAction="#handleDelete"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" minHeight="320.0">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="120.0"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="180.0"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="120.0"/>
            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="110.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
